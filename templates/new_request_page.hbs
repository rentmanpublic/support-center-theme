{{!-- ── NOTIFICATION BAR ────────────────────────────────────── --}}
<script type="text/plain" id="rm-dc-notification">{{dc 'support_center_notification'}}</script>
<div class="rm-notification-bar" id="rm-notification-bar" style="display:none" role="alert">
  <div class="rm-notification-bar__inner">
    <span class="rm-notification-bar__icon">⚠️</span>
    <span class="rm-notification-bar__text" id="rm-notification-text"></span>
  </div>
</div>

<div class="container-divider"></div>
<div class="container">
  <div class="sub-nav">
    {{breadcrumbs}}
  </div>

  <h1>
    {{t 'submit_a_request'}}
  </h1>

  <div id="main-content" class="form">
    <div id="new-request-form"></div>
  </div>
</div>

<script type="module">
  import { renderNewRequestForm } from "new-request-form";

  const container = document.getElementById("new-request-form");

  const settings = {{json settings}};

  const props = {
    requestForm: {{json new_request_form}},
    newRequestPath: {{json (page_path 'new_request')}},
    parentId: {{json parent.id}},
    parentIdPath: {{json parent.url}},
    locale: {{json help_center.locale}},
    baseLocale: {{json help_center.base_locale}},
    hasAtMentions: {{json help_center.at_mentions_enabled}},
    userRole: {{json user.role}},
    userId: {{json user.id}},
    brandId: {{json brand.id}},
    organizations: {{json user.organizations}},
    wysiwyg: true,
    answerBotModal: {
      answerBot: {{#if answer_bot}}{{json answer_bot}}{{else}}null{{/if}},
      answerBotGenerativeExperience: {{#if answer_bot_generative_experience}}{{json answer_bot_generative_experience}}{{else}}null{{/if}},
      hasRequestManagement: {{json help_center.request_management_enabled}},
      isSignedIn: {{json signed_in}},
      helpCenterPath: {{json (page_path 'help_center')}},
      requestsPath: {{json (page_path 'requests')}},
      requestPath: {{json (page_path 'request' id=request_id)}}
    },
  };

  renderNewRequestForm(settings, props, container);
</script>

{{!-- ── NOTIFICATION BAR SCRIPT (ES5, page-scoped) ──────────────
  Same behaviour as the homepage: show the dynamic content message if
  there is one, otherwise surface the first unresolved status incident.
  The logic lives per template because script.js carries none of it.
──────────────────────────────────────────────────────────────── --}}
<script>
(function () {
  var bar  = document.getElementById('rm-notification-bar');
  var text = document.getElementById('rm-notification-text');
  var dcEl = document.getElementById('rm-dc-notification');
  if (!bar || !text || !dcEl) { return; }

  var msg = (dcEl.textContent || '').trim();
  if (msg && msg !== 'off') {
    text.innerHTML = msg;
    bar.style.display = '';
    return;
  }

  fetch('https://status.rentman.io/api/v2/incidents/unresolved.json')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var incidents = (data.incidents || []);
      if (!incidents.length) { return; }
      var inc    = incidents[0];
      var sev    = inc.impact || 'minor';
      var update = inc.incident_updates && inc.incident_updates[0];
      bar.classList.add(sev === 'critical' ? 'rm-notification-bar--critical' : 'rm-notification-bar--major');
      text.innerHTML = '<strong>' + inc.name + '</strong>'
        + (update ? ' — ' + update.body : '')
        + ' <a href="https://status.rentman.io" target="_blank" rel="noopener">View status →</a>';
      bar.style.display = '';
    })
    .catch(function () {});
}());
</script>
