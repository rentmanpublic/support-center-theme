      </div>
      <div class="rm-onboard-select__group" role="group" aria-labelledby="rm-onboard-select-addons">
        <p class="rm-onboard-select__label" id="rm-onboard-select-addons">Add-ons</p>
        <div class="rm-onboard-select__chips">
          <button type="button" class="rm-onboard-chip" data-rm-product="qi" aria-pressed="false">Quoting &amp; Invoicing</button>
          <button type="button" class="rm-onboard-chip" data-rm-product="tracking" aria-pressed="false">Equipment Tracking</button>
