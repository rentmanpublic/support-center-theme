{{!-- ── SELECTOR SCRIPT (ES5, page-scoped) ─────────────────────── --}}
<script>
(function () {
  var KEYS = ['inventory', 'crew', 'organize', 'qi', 'tracking'];
  var STORE = 'rm-onboard-products';
  var root = document.getElementById('rm-onboard-blocks');
  if (!root) { return; }

  var chips = document.querySelectorAll('.rm-onboard-chip');
  var blocks = root.querySelectorAll('[data-rm-block]');
  var conditionals = root.querySelectorAll('[data-rm-show]');
  var strip = document.getElementById('rm-onboard-strip');
  var status = document.getElementById('rm-onboard-status');
  var resetBtn = document.getElementById('rm-onboard-reset');
  var selected = [];

  function has(list, key) { return list.indexOf(key) !== -1; }

  function clean(list) {
    var out = [];
    for (var i = 0; i < KEYS.length; i++) { if (has(list, KEYS[i])) { out.push(KEYS[i]); } }
    if (has(out, 'tracking') && !has(out, 'inventory')) { out.unshift('inventory'); }
    return clean2(out);
  }
  function clean2(list) {
    var out = [];
    for (var i = 0; i < KEYS.length; i++) { if (has(list, KEYS[i])) { out.push(KEYS[i]); } }
    return out;
  }

  function readUrl() {
    var m = /[?&]products=([^&#]*)/.exec(window.location.search);
    if (!m) { return null; }
    var raw = decodeURIComponent(m[1]).toLowerCase();
    return raw ? clean(raw.split(',')) : [];
  }
  function readStore() {
    try { var v = window.localStorage.getItem(STORE); return v ? clean(v.split(',')) : null; } catch (e) { return null; }
  }
  function writeStore() {
    try {
      if (selected.length) { window.localStorage.setItem(STORE, selected.join(',')); }
      else { window.localStorage.removeItem(STORE); }
    } catch (e) { /* storage unavailable */ }
  }
  function pathUrl() {
    var base = window.location.pathname;
    var query = window.location.search.replace(/[?&]products=[^&#]*/, '').replace(/^&/, '?');
    if (selected.length) { query += (query ? '&' : '?') + 'products=' + selected.join(','); }
    return base + query;
  }
  function writeUrl() {
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', pathUrl() + window.location.hash);
    }
  }

  // With no selection, every product counts as selected (full path).
  function active() { return selected.length ? selected : KEYS; }

  function matches(expr, list) {
    var parts = expr.split('&');
    for (var i = 0; i < parts.length; i++) {
      var p = parts[i].replace(/\s/g, '');
      if (!p) { continue; }
      var neg = p.charAt(0) === '!';
      var key = neg ? p.slice(1) : p;
      if (neg === has(list, key)) { return false; }
    }
    return true;
  }

  function pad(n) { return n < 10 ? '0' + n : String(n); }

  function render() {
    var list = active();
    var visible = [];
    var i;

    for (i = 0; i < blocks.length; i++) {
      var b = blocks[i];
      var key = b.getAttribute('data-rm-block');
      var show = key === 'platform' || has(list, key);
      b.hidden = !show;
      if (show) { visible.push(b); }
    }
    for (i = 0; i < conditionals.length; i++) {
      conditionals[i].hidden = !matches(conditionals[i].getAttribute('data-rm-show'), list);
    }

    var html = '';
    for (i = 0; i < visible.length; i++) {
      var num = pad(i + 1);
      var numEl = visible[i].querySelector('.rm-onboard-step__num');
      if (numEl) { numEl.textContent = num; }
      if (i % 2 === 1) { visible[i].classList.add('rm-onboard-step--alt'); }
      else { visible[i].classList.remove('rm-onboard-step--alt'); }
      html += '<a href="#' + visible[i].id + '" class="rm-onboard-strip__item">' +
        '<span class="rm-onboard-strip__num">' + num + '</span>' +
        '<span class="rm-onboard-strip__label">' + visible[i].getAttribute('data-rm-label') + '</span></a>';
      if (i < visible.length - 1) { html += '<span class="rm-onboard-strip__divider" aria-hidden="true">→</span>'; }
    }
    if (strip) { strip.innerHTML = html; }

    for (i = 0; i < chips.length; i++) {
      var k = chips[i].getAttribute('data-rm-product');
      chips[i].setAttribute('aria-pressed', has(selected, k) ? 'true' : 'false');
    }

    if (status) {
      // Localised copies are rendered into data attributes by the template.
      var allText   = status.getAttribute('data-all')   || 'Showing every product. Select yours to shorten the path.';
      var countText = status.getAttribute('data-count') || 'Your setup path has {n} steps.';
      status.textContent = selected.length
        ? countText.replace('{n}', visible.length)
        : allText;
    }
    if (resetBtn) { resetBtn.hidden = !selected.length; }
  }

  function track(event, data) {
    window.dataLayer = window.dataLayer || [];
    data.event = event;
    window.dataLayer.push(data);
  }

  function toggle(key) {
    var next = selected.slice();
    if (has(next, key)) {
      next.splice(next.indexOf(key), 1);
      if (key === 'inventory' && has(next, 'tracking')) { next.splice(next.indexOf('tracking'), 1); }
    } else {
      next.push(key);
    }
    selected = clean(next);
    render();
    writeUrl();
    writeStore();
    track('rm_onboarding_selection', { rm_products: selected.join(',') || 'all', rm_toggled: key });
  }

  for (var c = 0; c < chips.length; c++) {
    chips[c].addEventListener('click', function () { toggle(this.getAttribute('data-rm-product')); });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      selected = [];
      render(); writeUrl(); writeStore();
      track('rm_onboarding_selection', { rm_products: 'all', rm_toggled: 'reset' });
    });
  }


  // Article and video clicks, tagged with the block they sit in.
  document.addEventListener('click', function (e) {
    var a = e.target;
    while (a && a.tagName !== 'A') { a = a.parentNode; }
    if (!a || !a.getAttribute) { return; }
    var block = a.getAttribute('data-rm-block-link');
    if (!block) {
      var p = a;
      while (p && p !== document && !(p.getAttribute && p.getAttribute('data-rm-block'))) { p = p.parentNode; }
      block = p && p.getAttribute ? p.getAttribute('data-rm-block') : null;
    }
    if (!block) { return; }
    track('rm_onboarding_article_click', {
      rm_block: block,
      rm_article: a.getAttribute('href'),
      rm_products: selected.join(',') || 'all'
    });
  });

  // Initial state: URL wins, then the remembered selection, then the full path.
  var fromUrl = readUrl();
  selected = fromUrl !== null ? fromUrl : (readStore() || []);
  render();
  if (fromUrl === null && selected.length) { writeUrl(); }
  if (fromUrl !== null) { writeStore(); }
})();
</script>

{{!-- ── IMPLEMENTATION GUIDE MODAL (ES5, page-scoped) ──────────── --}}
<script>
(function () {
  var modal = document.getElementById('rm-impl-modal');
  if (!modal) { return; }
  var opener   = document.getElementById('rm-impl-open');
  var box      = modal.querySelector('.rm-impl-modal__box');
  var backdrop = modal.querySelector('.rm-impl-modal__backdrop');
  var closer   = modal.querySelector('.rm-impl-modal__close');
  var lastFocus = null;

  // Visible, focusable children of the dialog, in tab order.
  function focusable() {
    var all = box.querySelectorAll('a[href], button:not([disabled])');
    var out = [];
    for (var i = 0; i < all.length; i++) {
      if (all[i].offsetWidth || all[i].offsetHeight) { out.push(all[i]); }
    }
    return out;
  }

  function open() {
    lastFocus = document.activeElement;
    modal.classList.add('is-open');
    box.focus();
    document.addEventListener('keydown', onKey);
  }

  function close() {
    if (!modal.classList.contains('is-open')) { return; }
    modal.classList.remove('is-open');
    document.removeEventListener('keydown', onKey);
    if (lastFocus && lastFocus.focus) { lastFocus.focus(); }
  }

  function onKey(e) {
    if (e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27) { close(); return; }
    if (e.key !== 'Tab' && e.keyCode !== 9) { return; }
    var f = focusable();
    if (!f.length) { e.preventDefault(); return; }
    var first = f[0], last = f[f.length - 1], active = document.activeElement;
    // Keep Tab inside the dialog while it is open.
    if (!box.contains(active)) { e.preventDefault(); first.focus(); }
    else if (e.shiftKey && (active === first || active === box)) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
  }

  if (opener)   { opener.addEventListener('click', open); }
  if (backdrop) { backdrop.addEventListener('click', close); }
  if (closer)   { closer.addEventListener('click', close); }
}());
</script>
